APP_NAME=Learnfy AI
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=app/uploads
TEACHER_VERIFICATION_DIR=app/private/teacher-verifications
TEACHER_VERIFICATION_MAX_MB=5
STUDENT_VERIFICATION_DIR=app/private/student-verifications
STUDENT_VERIFICATION_MAX_MB=5
BACKEND_PUBLIC_URL=http://localhost:8000
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/learnfy_ai
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=20
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PRIVATE_URL_EXPIRE_SECONDS=900
UPLOAD_QUOTA_MB_PER_USER=250
ANTIVIRUS_ENABLED=false
ANTIVIRUS_REQUIRED=false
CLAMAV_HOST=
REDIS_URL=
TRUST_PROXY_HEADERS=false
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=payhere
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/payments
# PayHere one-time Premium access (disabled until approved credentials and HTTPS callback exist)
PAYHERE_ENABLED=false
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CURRENCY=LKR
PAYHERE_30_DAY_AMOUNT=500.00
PAYHERE_365_DAY_AMOUNT=5000.00
FREE_AI_CHAT_LIMIT=5
FREE_SUMMARY_LIMIT=3
FREE_QUIZ_LIMIT=2
FREE_FLASHCARDS_LIMIT=2
FREE_STUDY_PLANNER_LIMIT=1
PREMIUM_AI_CHAT_LIMIT=100
PREMIUM_SUMMARY_LIMIT=50
PREMIUM_QUIZ_LIMIT=30
PREMIUM_FLASHCARDS_LIMIT=30
PREMIUM_STUDY_PLANNER_LIMIT=20
# Optional on Linux; point to a Tamil/Sinhala-capable TrueType font for PDF export.
PDF_UNICODE_FONT_PATH=
