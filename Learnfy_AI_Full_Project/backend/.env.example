APP_NAME=Learnfy AI
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=app/uploads
TEACHER_VERIFICATION_DIR=app/private/teacher-verifications
TEACHER_VERIFICATION_MAX_MB=5
STUDENT_VERIFICATION_DIR=app/private/student-verifications
STUDENT_VERIFICATION_MAX_MB=5
BACKEND_PUBLIC_URL=http://localhost:8000
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/learnfy_ai
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=20
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional on Linux; point to a Tamil/Sinhala-capable TrueType font for PDF export.
PDF_UNICODE_FONT_PATH=
